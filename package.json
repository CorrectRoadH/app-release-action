{
  "name": "app-release-action",
  "version": "0.1.0",
  "private": true,
  "description": "Build OCI images, push to GHCR and request an authenticated application release",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-dist": "npm run build && git diff --exit-code -- dist"
  },
  "dependencies": {
    "@actions/artifact": "6.3.1",
    "@actions/core": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.0"
  }
}
